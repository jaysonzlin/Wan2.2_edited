Bootstrap: docker
From: nvidia/cuda:12.9.2-devel-ubuntu22.04

%files
    # Injects the Miniforge installer into the container
    ./Miniforge3-Linux-x86_64.sh /opt/miniforge.sh
    # Inject the local Utonia package without a network source checkout.
    ../Utonia /opt/Utonia

%post
    export DEBIAN_FRONTEND=noninteractive

    # 1. System Dependencies
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        wget \
        ninja-build \
        ca-certificates \
        pkg-config \
        libglvnd0 \
        libglvnd-dev \
        libgl1 \
        libglx0 \
        libegl1 \
        libgles2 \
        libgl1-mesa-dev \
        libegl1-mesa-dev \
        libgles2-mesa-dev \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender-dev \
        && apt-get clean && rm -rf /var/lib/apt/lists/*

    ldconfig

    # 2. Install Miniforge
    bash /opt/miniforge.sh -b -p /opt/conda
    rm /opt/miniforge.sh

    # 3. Mamba Environment Setup
    export CONDA_OVERRIDE_CUDA="12.9"

    /opt/conda/bin/mamba create -y -p /opt/conda/envs/app python=3.10
    
    # Keeping packaging and ninja as they are beneficial for runtime PyTorch JIT compilation
    /opt/conda/bin/mamba install -y -p /opt/conda/envs/app -c conda-forge packaging ninja

    # 4. Set Build Variables
    ENV_BIN="/opt/conda/envs/app/bin"
    ENV_PATH="/opt/conda/envs/app"

    export CUDA_HOME="/usr/local/cuda"
    export PATH="/usr/local/cuda/bin:$ENV_BIN:$PATH"
    export CUDACXX="/usr/local/cuda/bin/nvcc"

    export TORCH_CUDA_ARCH_LIST="7.0;8.0;9.0+PTX"
    export CPATH="$ENV_PATH/include:$CPATH"
    export LIBRARY_PATH="$ENV_PATH/lib:$LIBRARY_PATH"
    export FORCE_CUDA=1

    $ENV_BIN/pip install --upgrade pip setuptools wheel
    
    # Install the CUDA 12.6 PyTorch wheels used by the matching Utonia extensions.
    $ENV_BIN/pip install "numpy>=1.23.5,<2" "torch==2.5.1" "torchvision==0.20.1" --index-url https://download.pytorch.org/whl/cu126

    # 5. Install Simplified Requirements Configuration
    cat <<EOF > /tmp/requirements.txt
opencv-python>=4.9.0.80
diffusers>=0.31.0
transformers>=4.49.0
tokenizers>=0.20.3
accelerate>=1.1.1
tqdm
imageio
easydict
ftfy
dashscope
imageio-ffmpeg
gradio>=5.0.0
huggingface_hub[cli]
xfuser>=0.4.1
wandb
PyYAML>=6.0
Pillow>=10.0
h5py>=3.10
matplotlib>=3.8
timm
addict
psutil
einops
EOF
    
    $ENV_BIN/pip install -r /tmp/requirements.txt
    
    # Utonia's CUDA extensions match the installed Torch 2.5.1/cu126 wheels.
    $ENV_BIN/pip install --no-cache-dir "spconv-cu126==2.3.8" torch-scatter \
        -f https://data.pyg.org/whl/torch-2.5.1+cu126.html
    $ENV_BIN/pip install --no-deps -e /opt/Utonia

    # Build against the Torch 2.5.1 ABI instead of installing a Torch 2.4 wheel.
    $ENV_BIN/pip install "flash-attn==2.6.3" --no-build-isolation

    $ENV_BIN/python - <<'PY'
import flash_attn
import spconv.pytorch
import torch
import torch_scatter
import utonia

assert torch.__version__.startswith("2.5.1")
assert torch.version.cuda == "12.6"
print(f"Utonia runtime ready: torch={torch.__version__}, cuda={torch.version.cuda}")
PY

    # Cleanup
    rm /tmp/requirements.txt

    # Eliminate conda-shipped libcuda stubs to force runtime use of host drivers
    find /opt/conda -name "libcuda.so*" -delete 2>/dev/null || true
    find /opt/conda -name "libnvidia-ml.so*" -delete 2>/dev/null || true
    rm -rf /usr/local/cuda/lib64/stubs

    chmod 1777 /dev/shm 2>/dev/null || true

%environment
    export NVIDIA_DRIVER_CAPABILITIES=all
    export PYTHONNOUSERSITE=1

    # 1. Primary Pathing
    export PATH="/opt/conda/envs/app/bin:/opt/conda/bin:/usr/local/cuda/bin:$PATH"
    export LD_LIBRARY_PATH="/.singularity.d/libs:/usr/local/cuda/lib64:/opt/conda/envs/app/lib:$LD_LIBRARY_PATH"

    # 2. CUDA Home & JIT Compilation Headers
    export CUDA_HOME="/usr/local/cuda"
    export CPATH="/usr/local/cuda/include:$CPATH"
    export C_INCLUDE_PATH="/usr/local/cuda/include:$C_INCLUDE_PATH"
    export CPLUS_INCLUDE_PATH="/usr/local/cuda/include:$CPLUS_INCLUDE_PATH"
    export LIBRARY_PATH="/usr/local/cuda/lib64:$LIBRARY_PATH"
    export TORCH_CUDA_ARCH_LIST="7.0;8.0;9.0+PTX"

    # 3. SSL/Security Certificates
    export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
    export REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
    export CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

%runscript
    exec /bin/bash "$@"
